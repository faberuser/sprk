# Share the production toolchain and Wine runtime without building its binary.
FROM server-test-deps AS test-build
COPY Cargo.toml Cargo.lock ./
COPY server/Cargo.toml ./server/Cargo.toml
COPY server/src ./server/src
COPY server/migrations ./server/migrations
# Embedded by the PostgreSQL trigger and client-parity tests.
COPY server/tests/fixtures ./server/tests/fixtures
COPY tables ./tables
COPY config/mission-rule-gaps.json config/mission-rule-gaps.json
# The server checks its read-only endpoint list against the client request scheduler.
COPY client/managed/SprkNetworkPerformance/SprkNetworkPerformance.cs client/managed/SprkNetworkPerformance/SprkNetworkPerformance.cs
RUN cargo test --locked --no-run \
    && find target/debug/deps -maxdepth 1 -type f -executable -name 'sprk_server-*' \
       -exec cp {} /sprk-native-tests \;

FROM server-runtime AS native-tests
USER root
COPY --from=test-build /sprk-native-tests /usr/local/bin/sprk-native-tests
RUN mkdir -p /app/target/conquest-lab /app/target/party-followup \
    && chown -R sprk:sprk /app/target
USER sprk
WORKDIR /app
ENV CONQUEST_NATIVE_EXECUTABLE=/usr/local/bin/sprk-battle-worker
ENV SPRK_TABLE_FIXTURE=/app/tables
HEALTHCHECK NONE
ENTRYPOINT ["sprk-native-tests"]

