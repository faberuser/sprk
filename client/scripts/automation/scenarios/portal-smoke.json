    {"action": "assert-no-errors"},
    {"action": "click", "selector": "Game UI Root/Contents Group/PortalRenewal(Clone)/Panel/Root/TopPanel/Widget_ButtonTitle/Group_UITransform/Button_Exit"},
    {"action": "wait-ui", "contains": "Button_Portal"},
    {"action": "assert-no-errors"}
  ]
