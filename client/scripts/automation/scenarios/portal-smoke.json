{
  "description": "Run from the logged-in lobby. Saves existing errors before starting a new error checkpoint. UI-event clicks do not prove pointer hit testing.",
  "steps": [
    {"action": "snapshot"},
    {"action": "clear-errors"},
    {"action": "wait-ui", "contains": "Button_Portal"},
    {"action": "click", "selector": "Portal"},
