<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the Android update rules (SprkUpdate.cs, shared with the APK) without Unity.
       Run: dotnet run (project folder client/android/UpdateTests) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../HybridBootstrap/Assets/SprkBootstrap/SprkUpdate.cs" Link="SprkUpdate.cs" />
  </ItemGroup>
</Project>
