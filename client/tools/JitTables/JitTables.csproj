<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Edits the game's TableJit (.jit) files with the game's own table containers
    and serializer. It loads Assembly-CSharp.dll and runs its table code in this
    process; it never starts Unity. See docs/jit-tables.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);MSB3277;CS1701;CS1702</NoWarn>
    <!-- Staged by client/scripts/build/build_managed_client.py (or `client/dev.py build`). -->
    <ManagedReferenceDirectory Condition="'$(ManagedReferenceDirectory)' == ''">$(MSBuildThisFileDirectory)../../../artifacts/client-build/references</ManagedReferenceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedReferenceDirectory)/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="MessagePack"><HintPath>$(ManagedReferenceDirectory)/MessagePack.dll</HintPath></Reference>
    <Reference Include="MessagePack.Annotations"><HintPath>$(ManagedReferenceDirectory)/MessagePack.Annotations.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedReferenceDirectory)/UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
