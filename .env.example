# Set these as Portainer stack environment variables, or copy to .env for Compose.
SPRK_IMAGE=sprk-server:latest
SPRK_UPDATES_HOST_DIR=/srv/sprk/client-updates
SPRK_GAME_PORT=8080
SPRK_UPDATE_PORT=8081

# Addresses advertised to players. Set these to your reachable domain/IP.
# SERVER_HOST includes the HTTP port unless using the default 80/443.
SPRK_GAME_HOST=127.0.0.1:8080
SPRK_GAME_HTTPS=false
SPRK_SERVER_NAME=SPRK

SPRK_UPDATE_CPUS=1.0
SPRK_UPDATE_MEMORY=256m
