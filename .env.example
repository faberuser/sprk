# Set these as Portainer stack environment variables, or copy to .env for Compose.
# Shared game/update image built by GitHub Actions and pulled by Portainer.
SPRK_IMAGE=ghcr.io/faberuser/sprk:latest
SPRK_UPDATES_HOST_DIR=/srv/sprk/client-updates
SPRK_GAME_PORT=8080
SPRK_UPDATE_PORT=8081
SPRK_GM_KEY=replace_with_a_random_key_of_at_least_32_characters
SPRK_GM_BIND_IP=127.0.0.1
SPRK_GM_PORT=8082
# GM is disabled without a key. Use a random key of at least 32 characters.
# Set SPRK_GM_BIND_IP to your LAN/VPN IP for remote administration; never tunnel port 8082.

# Addresses advertised to players. Set these to your reachable domain/IP.
# SERVER_HOST includes the HTTP port unless using the default 80/443.
SPRK_GAME_HOST=127.0.0.1:8080
SPRK_GAME_HTTPS=false
SPRK_SERVER_NAME=SPRK

SPRK_UPDATE_CPUS=1.0
SPRK_UPDATE_MEMORY=256m

# Optional public-key override for startup-only GitHub client sync. The image
# includes config/client-update-public.pem, so normally leave this empty.
# Never put the private signing key in Portainer.
# CI pins the tag/repository inside the image. Leave both variables unset in
# Portainer so the image's values are preserved.
SPRK_UPDATES_PUBLIC_KEY=
