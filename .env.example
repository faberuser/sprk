# Copy to .env for Docker Compose, or set these as Portainer stack variables.
# start_server.bat (local Windows server) also reads .env; see the end.

# --- Players ---------------------------------------------------------------
# Address players reach, with the HTTP port unless it is 80/443.
SPRK_GAME_HOST=127.0.0.1:8080
# true when an HTTPS reverse proxy is in front.
SPRK_GAME_HTTPS=false
SPRK_SERVER_NAME=SPRK
SPRK_GAME_PORT=8080
SPRK_UPDATE_PORT=8081

# --- Database (PostgreSQL) -------------------------------------------------
# Three different long random passwords: letters, digits, - and _ only.
# Applied when the postgres volume is first created; change them later with
# ALTER ROLE, not here.
SPRK_DB_SUPERUSER_PASSWORD=replace_with_a_random_password
SPRK_DB_OWNER_PASSWORD=replace_with_a_random_password
SPRK_DB_APP_PASSWORD=replace_with_a_random_password
# Nightly backups. Create the directory first, owned by UID 999.
SPRK_DB_BACKUP_HOST_DIR=/srv/sprk/db-backups
SPRK_DB_BACKUP_DAYS=14
SPRK_DB_BACKUP_HOUR_UTC=4

# --- GM administration -----------------------------------------------------
# Random key of at least 32 characters; empty disables GM access.
SPRK_GM_KEY=replace_with_a_random_key_of_at_least_32_characters
# Keep 127.0.0.1, or use your LAN/VPN IP. Never expose or tunnel this port.
SPRK_GM_BIND_IP=127.0.0.1
SPRK_GM_PORT=8082

# --- Client updates --------------------------------------------------------
# Host directory for client releases, writable by UID/GID 10001.
SPRK_UPDATES_HOST_DIR=/srv/sprk/client-updates
# Leave empty: the image includes the public key. Never put the private key here.
SPRK_UPDATES_PUBLIC_KEY=

# --- Image and limits (defaults are fine) ----------------------------------
SPRK_IMAGE=ghcr.io/faberuser/sprk:latest
SPRK_UPDATE_CPUS=1.0
SPRK_UPDATE_MEMORY=256m
# About 25% of the memory available to PostgreSQL.
SPRK_DB_SHARED_BUFFERS=512MB
SPRK_DB_MAX_WAL_SIZE=4GB
# RUST_LOG=info,tower_http=debug

# --- Local start_server.bat only -------------------------------------------
# By default it runs PostgreSQL in the container sprk-postgres-local on
# 127.0.0.1:54320. Set DATABASE_URL to use another server instead (Compose
# ignores it and builds its URLs from the passwords above).
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/sprk
# SPRK_LOCAL_DB_PORT=54320
