# Copy to .env for Docker Compose, or set these as Portainer stack variables.
# start_server.bat (local Windows server) also reads .env; see the end.

# --- Players ---------------------------------------------------------------
# Address players reach, with the HTTP port unless it is 80/443.
SPRK_GAME_HOST=127.0.0.1:8080
# true when an HTTPS reverse proxy is in front.
SPRK_GAME_HTTPS=false
SPRK_SERVER_NAME=SPRK
SPRK_GAME_PORT=8080
SPRK_UPDATE_PORT=8081

# --- Database (PostgreSQL) -------------------------------------------------
# Three different long random passwords: letters, digits, - and _ only.
# Applied when the postgres volume is first created; change them later with
# ALTER ROLE, not here.
SPRK_DB_SUPERUSER_PASSWORD=replace_with_a_random_password
SPRK_DB_OWNER_PASSWORD=replace_with_a_random_password
SPRK_DB_APP_PASSWORD=replace_with_a_random_password
# Daily backups at SPRK_DB_BACKUP_HOUR_UTC, keeping the newest
# SPRK_DB_BACKUP_KEEP dumps. Create the directory first, owned by UID 999
# (on Docker Desktop, a folder such as ./data/db-backups is fine).
SPRK_DB_BACKUP_HOST_DIR=/srv/sprk/db-backups
SPRK_DB_BACKUP_KEEP=14
SPRK_DB_BACKUP_HOUR_UTC=4
# Optional off-host copy of each backup, e.g. a NAS mounted on the host.
# The directory must exist and be writable by UID 999; if it is missing (NAS
# not mounted), the backup service does not start. Empty disables the copy.
SPRK_DB_BACKUP_COPY_HOST_DIR=
# Dumps to keep there; defaults to SPRK_DB_BACKUP_KEEP.
SPRK_DB_BACKUP_COPY_KEEP=

# --- GM administration -----------------------------------------------------
# Random key of at least 32 characters; empty disables GM access.
SPRK_GM_KEY=replace_with_a_random_key_of_at_least_32_characters
# Keep 127.0.0.1, or use your LAN/VPN IP. Never expose or tunnel this port.
SPRK_GM_BIND_IP=127.0.0.1
SPRK_GM_PORT=8082

# --- Client updates --------------------------------------------------------
# Host directory for client releases, writable by UID/GID 10001 (on Docker
# Desktop, a folder such as ./data/client-updates is fine).
SPRK_UPDATES_HOST_DIR=/srv/sprk/client-updates
# Leave empty: the image includes the public key. Never put the private key here.
SPRK_UPDATES_PUBLIC_KEY=
# Total bandwidth for update and game asset downloads, in megabits per second,
# split evenly between the players downloading at the time. Set it below your
# upload speed so game traffic keeps headroom (e.g. 60% of it). Empty: no limit.
SPRK_UPDATES_MAX_MBPS=
# Header your reverse proxy puts the player's IP in, so players are told apart
# (CF-Connecting-IP for Cloudflare, X-Forwarded-For for most proxies). Only set
# it when the proxy overwrites the header; empty uses the connection's address.
SPRK_UPDATES_CLIENT_IP_HEADER=
# Download queue. Players downloading at once; others wait their turn (first
# come, first served) until one finishes. Empty: no limit.
SPRK_UPDATES_MAX_CLIENTS=
# Downloads one player may have open at once (the game opens 30, the launcher
# 4); the rest wait. Empty: no limit.
SPRK_UPDATES_MAX_CONNECTIONS_PER_CLIENT=
# Longest a request waits for a slot before it is let in anyway (1-240, default
# 120). The game gives up on a file after 300 s, so keep it well below that.
SPRK_UPDATES_QUEUE_MAX_WAIT_SECONDS=

# --- Asset mirror (Cloudflare R2) -----------------------------------------
# Game asset downloads are redirected to this copy of assets/objects once each
# object is on it; the server keeps serving anything not uploaded yet. Use the
# bucket's custom domain (not r2.dev), e.g. https://assets.example.com/assets/objects/
# See docs/game-assets.md. Empty: serve every asset from this server.
SPRK_ASSETS_MIRROR_URL=
# Uploader (assets-mirror service): R2 account ID, bucket, and an API token with
# Object Read & Write on that bucket. Empty bucket: the uploader stays idle.
SPRK_R2_ACCOUNT_ID=
SPRK_R2_BUCKET=
SPRK_R2_ACCESS_KEY_ID=
SPRK_R2_SECRET_ACCESS_KEY=
# Seconds between upload passes (each lists the bucket: ~1 request per 1000 objects).
SPRK_R2_SYNC_SECONDS=3600

# --- Battle workers --------------------------------------------------------
# Native worker processes simulating server-side battles (Conquest, party
# raids, online arena, dispatch), 1-64. Each runs its battles on its own
# thread and new fights go to the least busy one. Each is a full Unity
# process under Wine, so check one worker's memory use before raising this.
# Extra workers log to /data/conquest-worker-<n>.log.
SPRK_BATTLE_WORKERS=1
# How far behind the battle clock players watch server-run battles, 0-200 ms,
# sent to every player when a battle starts (Windows and Android alike).
# Each player's game applies battle logs at its own clock; this headroom lets
# logs that arrive a little late still apply at the moment the worker applied
# them. Lower: skills respond sooner. Higher: more jitter tolerance, less desync.
# Co-op covers Guild Conquest and party raids. 0 restores the old co-op behaviour.
SPRK_COOP_REPLAY_BUFFER_MS=100
SPRK_ARENA_REPLAY_BUFFER_MS=100
# Timing trace for diagnosing battle lag (frame gaps, command delays).
# 1 enables it; empty disables it. Turn it off afterwards: the file keeps growing.
SPRK_BATTLE_TRACE=
# Worker (Windows) path for the trace; Z:\data\ is the container's /data.
# Empty writes inside the worker's own data folder.
# SPRK_BATTLE_TRACE_FILE=Z:\data\sprk-battle.log
SPRK_BATTLE_TRACE_FILE=

# --- Image and limits (defaults are fine) ----------------------------------
SPRK_IMAGE=ghcr.io/faberuser/sprk:latest
SPRK_UPDATE_CPUS=1.0
SPRK_UPDATE_MEMORY=256m
# About 25% of the memory available to PostgreSQL.
SPRK_DB_SHARED_BUFFERS=512MB
# Connections per pool (main and read pool each, so the game uses up to twice
# this). PostgreSQL allows 100 in total by default: keep it at 45 or below.
SPRK_DB_MAX_CONNECTIONS=16
SPRK_DB_MAX_WAL_SIZE=4GB
# off (default): commits do not wait for the disk flush; a host crash can lose the last ~0.6 s of commits. on: strict durability, slower writes.
SPRK_DB_SYNCHRONOUS_COMMIT=off
# RUST_LOG=info,tower_http=debug

# --- Local start_server.bat only -------------------------------------------
# By default it runs PostgreSQL in the container sprk-postgres-local on
# 127.0.0.1:54320. Set DATABASE_URL to use another server instead (Compose
# ignores it and builds its URLs from the passwords above).
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/sprk
# SPRK_LOCAL_DB_PORT=54320
# With no local client update yet, the first start downloads the newest
# published client release from this repository's GitHub releases.
# SPRK_UPDATES_GITHUB_REPO=faberuser/sprk
# Android asset downloads: the public update URL plus /updates/assets/ (empty: off).
SPRK_ASSETS_CDN_URL=
